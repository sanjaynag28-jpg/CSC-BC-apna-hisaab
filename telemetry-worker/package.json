{
  "name": "cmbc-fleet-monitor-worker",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Cloudflare Worker + D1 fleet monitor & central error telemetry for CSC & BC Apna Hisaab",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute cmbc-fleet-db --remote --file=./schema.sql",
    "db:local": "wrangler d1 execute cmbc-fleet-db --local --file=./schema.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^3.100.0"
  }
}
