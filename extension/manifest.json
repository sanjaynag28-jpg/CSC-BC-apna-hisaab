{
  "manifest_version": 3,
  "name": "Cash Management BC - AEPS, CSC & Bill Pay Grabber",
  "version": "1.3.30",
  "description": "CSC AEPS, Digipay, UPPCL Electricity Bill & EMI Payments Auto-Capture directly into Cash Management",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Auto-Grab & Open in Cash Management (Alt+C) | In-Page Overlay (Alt+Shift+C)"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Auto-Grab & Open in Cash Management Project (Tarika B)"
    },
    "open_inpage_overlay": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open In-Page Mirror Overlay (Tarika C)"
    }
  }
}