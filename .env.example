# Copy this file to .env and update your local SQL Server details
PORT=3000
HOST=0.0.0.0

# SQL Server Connection (Example: localhost\SQLEXPRESS or YOUR-PC-NAME\SQLEXPRESS)
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=CashManagement
DB_USER=sa
DB_PASSWORD=YourStrongPasswordHere

# Random secret string for authentication tokens (change this to any long random string)
JWT_SECRET=change_this_to_a_long_random_secret_string_12345

# Automatic Silent Updates from GitHub (enabled by default for all users)
# Set AUTO_UPDATE_DISABLED=true only if you are actively developing/editing code locally
AUTO_UPDATE_DISABLED=false
