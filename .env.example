# Cash Management - SQLite Edition Configuration
PORT=4000
HOST=0.0.0.0

# Embedded SQLite Database (No SQL Server required)
DB_TYPE=sqlite
DB_FILE=database/data/cash_management.db

# Generate a unique secret for this installation before starting the server.
# PowerShell: $r=[Security.Cryptography.RandomNumberGenerator]::Create(); $b=New-Object byte[] 48; $r.GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Keep loopback auto-login only for a trusted local desktop installation.
# Set to false if local requests must also authenticate.
ALLOW_LOCAL_AUTO_LOGIN=true

# Automatic Silent Updates from GitHub
AUTO_UPDATE_DISABLED=false
