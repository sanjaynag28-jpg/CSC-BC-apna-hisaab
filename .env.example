# Cash Management - SQLite Edition Configuration
PORT=4000
HOST=0.0.0.0

# Embedded SQLite Database (No SQL Server required)
DB_TYPE=sqlite
DB_FILE=database/data/cash_management.db

# Random secret string for authentication tokens
JWT_SECRET=cash_management_sqlite_edition_secret_key_4000

# Automatic Silent Updates from GitHub
AUTO_UPDATE_DISABLED=false
